  "scripts": {
    "start:dev": "cross-env NODE_ENV=development TZ=Asia/Ho_Chi_Minh ts-node-dev --respawn -r dotenv/config ./src/index.ts dotenv_config_path=.env.development",
    "migrate:dev": "dotenv -e .env.development npx prisma migrate dev --name init",
    "generate": "dotenv -e .env.development npx prisma generate",
    "pull:dev": "dotenv -e .env.development npx prisma db pull",
    "push:dev": "dotenv -e .env.development npx prisma db push",
    "reset:dev": "dotenv -e .env.development npx prisma migrate reset",
    "clear:dev": "dotenv -e .env.development npx prisma migrate reset --force-reset",
    "status:dev": "dotenv -e .env.development npx prisma migrate status",
    "deploy:dev": "dotenv -e .env.development npx prisma deploy",
    "studio": "dotenv -e .env.development npx prisma studio ",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "_moduleAliases": {
    "@controllers": "src/controllers",
    "@modules": "src/modules",
    "@services": "src/services",
    "@utils": "src/utils",
    "@enums": "src/enums",
    "@workers": "src/workers"
  },
